{
  "name": "project-elpis-server",
  "version": "3.0.0",
  "description": "Back-end server for Project Elpis ('BEACON Q')",
  "main": "dist/server.js",
  "scripts": {
    "generate:schemas": "node scripts/generateSchemas.js",
    "predev": "npm run generate:schemas",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p .",
    "build:watch": "tsc -p . --watch",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p . --noEmit",
    "prepare": "husky"
  },
  "author": "Aryobarzan Atashpendar",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.20.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-simple": "^0.5.6",
    "luxon": "^3.7.2",
    "mongoose": "^9.9.4",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rotating-file-stream": "^3.2.10",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/node-schedule": "^2.1.8",
    "@types/passport-jwt": "^4.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "ts-json-schema-generator": "^2.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "jsonwebtoken": {
      "jwa": "^2.0.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
